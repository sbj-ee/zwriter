[Desktop Entry]
Type=Application
Name=zwriter
GenericName=Writer
Comment=Distraction-free writing for Linux and Apple Silicon
Exec=zwriter %F
Icon=zwriter
Terminal=false
Categories=Office;WordProcessor;
Keywords=writer;typewriter;prose;text;document;
StartupNotify=true
StartupWMClass=zwriter
MimeType=application/vnd.oasis.opendocument.text;text/plain;application/rtf;text/rtf;
