cmake_minimum_required(VERSION 3.16)
# cmake -P: the .deb dependency list installs on Debian 13 and Ubuntu 24.04.
include(${SRC}/cmake/DebDepends.cmake)
set(_seen "")
foreach(_d IN LISTS ZWRITER_DEB_DEPENDS)
  string(REGEX MATCH "^[a-z0-9.+-]+" _first "${_d}")
  if(_first IN_LIST _seen)
    message(FATAL_ERROR "listed twice: ${_first}")
  endif()
  list(APPEND _seen "${_first}")
  if(_d MATCHES "t64")
    if(NOT _first MATCHES "t64$" AND _d MATCHES "\\|")
      continue()
    endif()
    message(FATAL_ERROR "t64 name without a Debian alternative first: ${_d}")
  endif()
endforeach()
foreach(_need libqt6core6 libqt6gui6 libqt6widgets6 libqt6network6 libqt6printsupport6 libhunspell-1.7-0 libsodium23)
  if(NOT _need IN_LIST _seen)
    message(FATAL_ERROR "missing dependency ${_need}")
  endif()
endforeach()
message(STATUS "deb depends OK: ${ZWRITER_DEB_DEPENDS_STRING}")
